{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fruit-defense.local/schemas/wechat-compatibility-report-v1.json",
  "title": "Fruit Defense WeChat compatibility report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "generatedAtUtc",
    "overallStatus",
    "project",
    "officialAdapterCandidate",
    "pinnedVersions",
    "credentialPresence",
    "artifactSizes",
    "officialLimits",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "platform": { "const": "wechat-minigame" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "overallStatus": { "$ref": "#/$defs/status" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unityVersion", "gitRevision"],
      "properties": {
        "unityVersion": { "type": "string" },
        "gitRevision": { "type": "string" }
      }
    },
    "officialAdapterCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "observedCommit", "changelogVersion", "packageManifestVersion", "retrievedAtUtc"],
      "properties": {
        "repository": { "type": "string" },
        "observedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "changelogVersion": { "type": "string" },
        "packageManifestVersion": { "type": "string" },
        "retrievedAtUtc": { "type": "string", "format": "date-time" }
      }
    },
    "pinnedVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wxsdkReference", "wxsdkCommit", "developerTools", "wechatClient", "baseLibrary", "hostBaseline"],
      "properties": {
        "wxsdkReference": { "type": ["string", "null"] },
        "wxsdkCommit": { "type": ["string", "null"] },
        "developerTools": { "type": ["string", "null"] },
        "wechatClient": { "type": ["string", "null"] },
        "baseLibrary": { "type": ["string", "null"] },
        "hostBaseline": { "type": ["string", "null"] }
      }
    },
    "credentialPresence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appId", "developerSession", "uploadPrivateKey"],
      "properties": {
        "appId": { "type": "boolean" },
        "developerSession": { "type": "boolean" },
        "uploadPrivateKey": { "type": "boolean" }
      }
    },
    "artifactSizes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["webglBuildBytes", "convertedMiniGameBytes"],
      "properties": {
        "webglBuildBytes": { "type": "integer", "minimum": 0 },
        "convertedMiniGameBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "officialLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mainCodePackageMb", "totalCodePackageMb", "singleSubpackageMb", "firstResourcePackageMb", "evidence"],
      "properties": {
        "mainCodePackageMb": { "type": ["integer", "null"], "minimum": 1 },
        "totalCodePackageMb": { "type": ["integer", "null"], "minimum": 1 },
        "singleSubpackageMb": { "type": ["integer", "null"], "minimum": 1 },
        "firstResourcePackageMb": { "type": ["integer", "null"], "minimum": 1 },
        "evidence": { "type": "string" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "status": { "enum": ["Green", "Yellow", "Red"] },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "blocking", "evidence", "observedAtUtc", "nextAction"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "blocking": { "type": "boolean" },
        "evidence": { "type": "string" },
        "observedAtUtc": { "type": "string", "format": "date-time" },
        "nextAction": { "type": "string" }
      }
    }
  }
}
