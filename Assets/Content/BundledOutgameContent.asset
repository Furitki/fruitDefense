  catalog:
    header:
      schemaVersion: 1
      catalogId: catalog.outgame.orchard
      contentVersion: 1.0.0
      minCodeVersion: 0.1.0
    items:
    - id: item.growth.morning-dew
      presentationId: presentation.outgame.item.morning-dew
      displayName: 晨露
      description: 果园活动产出的成长素材，可用于装备强化与培育。
      maximumQuantity: 999
    activities:
    - id: activity.orchard.starter-supplies
      presentationId: presentation.outgame.activity.starter-supplies
      displayName: 果园启程礼
      description: 领取一次起步物资，获得成长装备与可完成首轮强化的素材。
      bundledAvailable: 1
      receiptId: receipt.activity.orchard.starter-supplies
      rewards:
      - operationId: reward.growth-equipment
        itemId: 
        growthEquipmentId: growth-equipment.sunleaf-emblem
        quantity: 1
        initialRank: 0
      - operationId: reward.item
        itemId: item.growth.morning-dew
        growthEquipmentId: 
        quantity: 6
        initialRank: 0
    growthEquipment:
    - id: growth-equipment.sunleaf-emblem
      presentationId: presentation.outgame.equipment.sunleaf-emblem
      displayName: 晨叶徽章
      description: 出战前佩戴的进攻成长装备，提高守卫伤害。
      slotId: growth-slot.offense
      ranks:
      - rank: 0
        costs: []
        contributions:
        - domainId: growth-domain.equipment
